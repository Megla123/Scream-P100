+def startup_tuning(cfg):
+    """Apply backend preset defaults while building the configured startup snapshot."""
+    plan = cfg.get("scream_runtime_settings")
+    tuned = apply_saved_tuning(cfg)
+    if tuned is cfg or plan is None:
+        return tuned
+    explicit_user_args = user_args.capture(cfg)
+    flags = set(plan.get("tuning_flags", ()))
+    flags.update(user_args.flag_of(group) for group in user_args.groups(explicit_user_args))
+    original = user_args.groups(cfg.get("args"))
+    chosen = [group for group in original if user_args.flag_of(group) in flags]
+    defaults = [group for group in user_args.groups(tuned.get("args")) if user_args.flag_of(group) not in flags]
+    tuned["args"] = user_args.flat(defaults + chosen)
+    if "args_written" in cfg or "user_args" in cfg:
+        user_args.stamp(tuned, explicit_user_args)
+    protected_env = set(plan.get("tuning_environment", ()))
+    tuning = (tuned.get("sampling") or {}).get("strata_tune")
+    if isinstance(tuning, dict) and "strata_tune" not in (cfg.get("sampling") or {}):
+        raw = dict(tuning)
+        for key in ("pcie_frac", "spec_min_p", "prefill_pipe", "aux_cpus"):
+            if "--" + key.replace("_", "-") in flags or "STRATA_" + key.upper() in protected_env:
+                raw.pop(key, None)
+        tuned["sampling"] = {**tuned["sampling"], "strata_tune": raw}
+    env = dict(tuned.get("env") or {})
+    explicit = cfg.get("env") or {}
+    for key in protected_env & env.keys():
+        if key in explicit:
+            env[key] = explicit[key]
+        else:
+            env.pop(key)
+    tuned["env"] = env
+    return tuned
