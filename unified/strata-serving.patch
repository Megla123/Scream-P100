 class TestInklingDialect(unittest.TestCase):
+    @staticmethod
+    def native_tool_parser(incremental=True):
+        parser = frontend.InklingOutputParser(tools=[{"name": "apply_patch"}], stream_tools=True,
+                                               declared_only=True, incremental_envelopes=incremental)
+        parser.feed_token(inkling_dialect.MSG_MODEL, is_special=True)
+        parser.feed_token("apply_patch", is_special=False)
+        parser.feed_token(inkling_dialect.CONTENT_TOOL_JSON, is_special=True)
+        return parser
+
+    def test_native_tool_arguments_stream_before_the_closing_token(self):
+        args = {"patch": 'é 🐍 \\" {} </tool_call> <|end_message|>' * 32, "options": [{"value": True}]}
+        body = json.dumps({"name": "apply_patch", "args": args}, ensure_ascii=False)
+        parser = self.native_tool_parser()
+        chunks = []
+        for i in range(0, len(body), 7):
+            chunks.extend(parser.feed_token(body[i:i + 7], is_special=False))
+        self.assertEqual(chunks[0].kind, "tool_start")
+        call = chunks[0].call
+        self.assertEqual(call.name, "apply_patch")
+        self.assertGreater(len(chunks), 3)
+        self.assertTrue(all(event.kind == "tool_args" and event.call.id == call.id for event in chunks[1:]))
+        fragments = "".join(event.text for event in chunks[1:])
+        with self.assertRaises(json.JSONDecodeError):
+            json.loads(fragments)
+        ending = parser.feed_token(inkling_dialect.END_MSG, is_special=True)
+        self.assertEqual([event.kind for event in ending], ["tool_args", "tool_call"])
+        self.assertEqual(json.loads(fragments + ending[0].text), args)
+        self.assertEqual(ending[1].call, frontend.ToolCall("apply_patch", args, call.id))
+
+    def test_invalid_or_interrupted_native_tool_envelope_is_never_confirmed(self):
+        parser = self.native_tool_parser()
+        body = json.dumps({"name": "apply_patch", "args": {"patch": "A" * 600}})
+        parser.feed_token(body, is_special=False)
+        parser.feed_token('garbage after the outer brace', is_special=False)
+        with self.assertRaisesRegex(ValueError, "invalid streamed Inkling tool envelope"):
+            parser.feed_token(inkling_dialect.END_MSG, is_special=True)
+        parser = self.native_tool_parser()
+        parser.feed_token(body, is_special=False)
+        self.assertEqual(parser.finish("length"), [])
+        parser = self.native_tool_parser(incremental=False)
+        self.assertEqual(parser.feed_token(body, is_special=False), [])
+        ending = parser.feed_token(inkling_dialect.END_MSG, is_special=True)
+        self.assertEqual([event.kind for event in ending], ["tool_call"])
+
