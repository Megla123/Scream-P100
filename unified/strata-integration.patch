+// Read Strata's SVE1 records in prompt order. The adapter expands each picture's placeholder before GENI.
+inline bool read_inkling_embeddings(const std::string& path, const std::vector<int32_t>& ids,
+                                    int image_pad, int hidden, std::vector<int32_t>& img_idx,
+                                    std::vector<float>& embeddings, std::string& err) {
+    std::ifstream input(path, std::ios::binary | std::ios::ate);
+    const auto end = input.tellg();
+    if (!input || end <= std::streampos(0)) { err = "cannot read image embeddings"; return false; }
+    const size_t pads = std::count(ids.begin(), ids.end(), image_pad);
+    const size_t row_bytes = (size_t)hidden * sizeof(float);
+    if (pads == 0 || ids.back() == image_pad ||
+        (uint64_t)end > pads * (row_bytes + 5 * sizeof(int32_t))) {
+        err = "image embeddings do not match the prompt";
+        return false;
+    }
+    input.seekg(0);
+    img_idx.assign(ids.size(), -1);
+    embeddings.clear();
+    size_t rows = 0, pos = 0;
+    while (input.tellg() < end) {
+        int32_t h[5]{};
+        if (!input.read(reinterpret_cast<char*>(h), sizeof(h)) ||
+            h[0] != 0x31455653 || h[1] <= 0 || h[2] <= 0 || h[3] <= 0 ||
+            (int64_t)h[2] * h[3] != h[1] || h[4] != hidden || (size_t)h[1] > pads - rows) {
+            err = "invalid SVE1 image embeddings record";
+            return false;
+        }
+        while (pos < ids.size() && ids[pos] != image_pad) ++pos;
+        const size_t count = (size_t)h[1];
+        for (size_t i = 0; i < count; ++i, ++pos) {
+            if (pos >= ids.size() || ids[pos] != image_pad) {
+                err = "image embeddings do not match the prompt";
+                return false;
+            }
+            img_idx[pos] = static_cast<int32_t>(rows + i);
+        }
+        const size_t bytes = count * row_bytes;
+        if ((uint64_t)(end - input.tellg()) < bytes) { err = "short image embeddings record"; return false; }
+        embeddings.resize((rows + count) * hidden);
+        float* first = embeddings.data() + rows * hidden;
+        if (!input.read(reinterpret_cast<char*>(first), bytes) ||
+            !std::all_of(first, first + count * hidden, [](float v) { return std::isfinite(v); })) {
+            err = "invalid image embedding values";
+            return false;
+        }
+        rows += count;
+    }
+    if (rows != pads) { err = "image embeddings do not match the prompt"; return false; }
+    return true;
 }
 
